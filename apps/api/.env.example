# Base de datos (PostgreSQL). En desarrollo usamos Postgres GESTIONADO — sin Docker,
# sin instalar nada en tu máquina (ADR-005). Recomendado: Neon (free tier) o Railway.
#
#   1. Crea un proyecto Postgres en https://neon.tech (gratis) o en Railway.
#   2. Copia la "connection string" y pégala abajo (en tu .env real, no en este ejemplo).
#
DATABASE_URL="postgresql://usuario:password@host/gambetea?sslmode=require"

# Secreto para firmar los JWT de sesión. Genera uno largo y aleatorio en producción.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Proveedor del Football Data Hub: "mock" (dev) o "api-football" (datos reales, ADR-019)
DATA_PROVIDER="mock"

# API-Football (solo si DATA_PROVIDER=api-football). Key gratuita en api-football.com
APIFOOTBALL_KEY=""
APIFOOTBALL_LEAGUE="140"   # 140 = LaLiga
APIFOOTBALL_SEASON="2023"  # 2023 = temporada 2023/24

# Recuperación de contraseña (forgot password)
WEB_URL="http://localhost:3000"   # base de los enlaces del email; en prod, el dominio del web
# Email vía Resend (https://resend.com, plan gratuito). Sin esto, en dev el enlace sale en el log.
RESEND_API_KEY=""
MAIL_FROM="Gambetea <onboarding@resend.dev>"   # remitente (con dominio verificado en Resend para prod)
